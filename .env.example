# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Local PostgreSQL - In-House Only)
# Format: postgresql://<username>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://app_user:YOUR_PASSWORD@localhost:5432/student_education_db?schema=public"

# Authentication Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=15m

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=30
